<Window x:Class="blinkpip.PipControls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" ResizeMode="NoResize" Focusable="False" Width="460" Height="44">
    <!-- PIP·전체 화면에서 영상 위에 떠 있는 재생 컨트롤. 영상(mpv)은 자식 HWND 라 그 위에 WPF 요소를 겹칠 수 없어
         별도 최상위 창(활성화되지 않음)으로 만든다. 위치·표시/숨김은 MainWindow 가 정한다. -->
    <Border CornerRadius="10" Background="#E6121212" BorderBrush="#3A3A3A" BorderThickness="1" Padding="8,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayBtn" Grid.Column="0" Style="{StaticResource PlayButton}" Content="&#xE769;" Click="PlayBtn_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00 / 0:00" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                       Margin="10,0" VerticalAlignment="Center" MinWidth="86" TextAlignment="Center"/>
            <Slider x:Name="Seek" Grid.Column="2" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged" VerticalAlignment="Center"/>
            <Button x:Name="MuteBtn" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE767;" Click="MuteBtn_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="FullBtn" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE740;" Click="FullBtn_Click" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
