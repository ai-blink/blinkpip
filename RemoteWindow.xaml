<Window x:Class="HybridPipPlayer.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        Title="리모컨" KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <!-- 앱 정중앙에 뜨는 4×3 리모컨. 영상(mpv)·웹뷰는 자식 HWND 라 WPF 요소를 겹칠 수 없어 별도 최상위 창으로 띄운다.
         칸은 코드에서 채운다(기본 5칸 + 즐겨찾기 6칸 + 편집 1칸). -->
    <Window.Resources>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 시안 3 의 카드 방식: 위→아래 은은한 그라데이션 + 위쪽 안쪽 하이라이트(곡선을 따라감) + 약한 겹 그림자 -->
                        <Grid>
                            <Border CornerRadius="11" Background="#26000000" Margin="0,2,0,-2"/>
                            <Border CornerRadius="11" Background="#26000000" Margin="1,3,1,-3"/>
                            <Border x:Name="Bd" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2E2E2E" Offset="0"/>
                                        <GradientStop Color="#1D1D1D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border CornerRadius="10" BorderThickness="1" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2AFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnGradient}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="16" Background="{DynamicResource BarBrush}" BorderBrush="#3A3A3A" BorderThickness="1" Padding="14,10,14,14">
        <StackPanel>
            <Grid Margin="0,0,0,10" Height="30">
                <Button x:Name="BackBtn" Content="‹ 뒤로" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Back_Click" Visibility="Collapsed" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="TitleText" Text="리모컨" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" ToolTip="닫기 (Esc)" AutomationProperties.Name="닫기"/>
            </Grid>
            <StackPanel x:Name="TabRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed">
                <Button x:Name="TabFav" Style="{StaticResource CellButton}" Height="28" Width="170" Margin="0,0,6,0" Click="TabFav_Click" AutomationProperties.Name="리모컨 즐겨찾기 탭"><TextBlock Text="리모컨 즐겨찾기 (6)"/></Button>
                <Button x:Name="TabMain" Style="{StaticResource CellButton}" Height="28" Width="170" Click="TabMain_Click" AutomationProperties.Name="메인 툴바 탭"><TextBlock Text="메인 툴바에 추가 (최대 4)"/></Button>
            </StackPanel>
            <UniformGrid x:Name="Cells" Columns="4" Rows="3"/>
            <TextBlock x:Name="Hint" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Height="34"/>
        </StackPanel>
    </Border>
</Window>
