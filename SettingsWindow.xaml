<Window x:Class="HybridPipPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="800" Height="560" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BarBrush}" FontSize="13" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- 설정 한 줄: 왼쪽 이름·설명, 오른쪽 조작 -->
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목 줄 (끌어서 이동) -->
            <Border Grid.Row="0" Background="{DynamicResource BarDeepBrush}" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0">
                    <TextBlock Text="설정" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽 사이드바 -->
                <Border Grid.Column="0" Background="{DynamicResource BarDeepBrush}" BorderBrush="#14FFFFFF" BorderThickness="0,1,1,0">
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                             ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="Nav_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="재생" IsSelected="True"/>
                        <ListBoxItem Content="모양"/>
                        <ListBoxItem Content="PIP"/>
                        <ListBoxItem Content="오디오 · 자막"/>
                        <ListBoxItem Content="화면 · 소리 조절"/>
                        <ListBoxItem Content="북마크 · 정보"/>
                    </ListBox>
                </Border>

                <!-- 오른쪽 내용 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,22,28,22">

                        <!-- 0. 재생 -->
                        <StackPanel x:Name="Pane0">
                            <TextBlock Text="재생" Style="{StaticResource PaneTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="재생 바 위치" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="재생·탐색·볼륨 줄을 어디에 둘지 정합니다. 기본은 영상 아래입니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton x:Name="PosBottom" Content="아래" GroupName="pos" Style="{StaticResource SegmentRadio}" Checked="Pos_Checked"/>
                                    <RadioButton x:Name="PosTop" Content="위" GroupName="pos" Style="{StaticResource SegmentRadio}" Checked="Pos_Checked"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="기본 볼륨" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="앱을 켤 때의 볼륨입니다. 바꾸면 지금 볼륨도 같이 바뀝니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="VolSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Vol_ValueChanged"/>
                                    <TextBlock x:Name="VolText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="기본 재생 속도" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="앱을 켤 때의 속도입니다. 바꾸면 지금 속도도 같이 바뀝니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <Button x:Name="SpeedPick" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="80" Height="28" Click="SpeedPick_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="전체 화면 컨트롤 숨김 시간" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="마우스가 멈춘 뒤 컨트롤이 사라질 때까지의 시간입니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="FsHideSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="FsHide_ValueChanged"/>
                                    <TextBlock x:Name="FsHideText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="건너뛰기 간격" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="좌우 방향키와 재생 줄의 -/+ 버튼이 움직이는 시간입니다. Shift 를 함께 누르면 6배입니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="SeekSecSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SeekSec_ValueChanged"/>
                                    <TextBlock x:Name="SeekSecText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="이어 보기" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="영상을 다시 열면 마지막으로 본 위치부터 재생합니다(15초를 넘는 영상)." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <CheckBox x:Name="ResumeToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Resume_Changed" Unchecked="Resume_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="폴더 자동 재생 목록" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="파일 하나를 열면 같은 폴더의 영상·음악을 재생 목록으로 올려 이어서 재생합니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoPlaylistToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="AutoPlaylist_Changed" Unchecked="AutoPlaylist_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="이어 보기 기록" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="저장된 마지막 위치를 모두 지웁니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <Button Content="기록 지우기" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" MinWidth="90" Click="ClearResume_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- 1. 모양 -->
                        <StackPanel x:Name="Pane1" Visibility="Collapsed">
                            <TextBlock Text="모양" Style="{StaticResource PaneTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="색 테마" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="누르면 바로 바뀝니다." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <StackPanel x:Name="ThemePanel" Orientation="Vertical" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="북마크 줄 표시" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="끄면 주소 줄만 남고 창이 그만큼 줄어듭니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <CheckBox x:Name="BookmarksToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="BookmarksToggle_Changed" Unchecked="BookmarksToggle_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="스크린샷 알림 투명도" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="낮출수록 알림 뒤의 영상이 비쳐 보입니다. 100 이면 불투명합니다." Style="{StaticResource RowHint}" MaxWidth="260"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="ToastOpacitySlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ToastOpacity_ValueChanged"/>
                                    <TextBlock x:Name="ToastOpacityText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="스크린샷 알림 표시 시간" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="알림이 떠 있다가 사라질 때까지의 시간입니다. 마우스를 올려 두면 사라지지 않습니다." Style="{StaticResource RowHint}" MaxWidth="260"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="ToastSecondsSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ToastSeconds_ValueChanged"/>
                                    <TextBlock x:Name="ToastSecondsText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="알림 미리 보기" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="지금 설정으로 알림을 한 번 띄웁니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <Button Content="미리 보기" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" MinWidth="90" Click="ToastPreview_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- 2. PIP -->
                        <StackPanel x:Name="Pane2" Visibility="Collapsed">
                            <TextBlock Text="PIP" Style="{StaticResource PaneTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="PIP 창 너비" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="다음에 PIP 로 들어갈 때 적용됩니다. PIP 가장자리를 끌어 크기를 바꾸면 그 너비가 여기에 저장됩니다. 높이는 영상 비율에 맞춥니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="PipWidthSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="320" Maximum="960" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="PipWidth_ValueChanged"/>
                                    <TextBlock x:Name="PipWidthText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="컨트롤 사라지는 시간" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="마우스가 PIP 를 벗어난 뒤 컨트롤과 자물쇠가 사라질 때까지의 시간입니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="PipHideSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="PipHide_ValueChanged"/>
                                    <TextBlock x:Name="PipHideText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="자막을 창 아래에 표시" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="PIP 에서 영상 안 자막을 숨기고 창 바로 아래 줄에 보여 줍니다. 로컬 영상과 디즈니+ 에 적용됩니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <CheckBox x:Name="PipSubBelowToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="PipSubBelow_Changed" Unchecked="PipSubBelow_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="창 아래 자막 크기" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="PIP 에서 Ctrl+Alt+↑/↓ 로도 바꿀 수 있습니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="PipSubSizeSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="10" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PipSubSize_ValueChanged"/>
                                    <TextBlock x:Name="PipSubSizeText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 3. 오디오 · 자막 -->
                        <StackPanel x:Name="Pane3" Visibility="Collapsed">
                            <TextBlock Text="오디오 · 자막" Style="{StaticResource PaneTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="오디오 출력 장치" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="소리를 내보낼 장치입니다. 누르면 목록이 열립니다." Style="{StaticResource RowHint}" MaxWidth="260"/>
                                </StackPanel>
                                <Button x:Name="DevicePick" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="160" MaxWidth="280" Height="28" Click="DevicePick_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="자막 글자 크기" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="기본은 90 입니다. 바로 적용됩니다." Style="{StaticResource RowHint}" MaxWidth="320"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Slider x:Name="SubSizeSlider" Style="{StaticResource PlayerSlider}" Width="170" Minimum="30" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SubSize_ValueChanged"/>
                                    <TextBlock x:Name="SubSizeText" Style="{StaticResource ValueText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="자막 글꼴" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="로컬 영상, 디즈니+, PIP 아래 자막 줄에 함께 적용됩니다. 스타일이 들어 있는 자막(ASS)은 원래 모양을 유지합니다." Style="{StaticResource RowHint}" MaxWidth="280"/>
                                </StackPanel>
                                <Button x:Name="SubFontPick" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="160" MaxWidth="280" Height="28" Click="SubFontPick_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="자막 색" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="글자 색입니다. 바로 적용됩니다." Style="{StaticResource RowHint}" MaxWidth="280"/>
                                </StackPanel>
                                <Button x:Name="SubColorPick" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="160" MaxWidth="280" Height="28" Click="SubColorPick_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="선호 자막 언어" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="쉼표로 구분한 언어 코드, 예: ko,kor,en. 비우면 기본 동작입니다. 다음에 여는 파일부터 적용됩니다." Style="{StaticResource RowHint}" MaxWidth="280"/>
                                </StackPanel>
                                <TextBox x:Name="SubLangBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="180" Height="28" LostFocus="Langs_LostFocus" KeyDown="Langs_KeyDown"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="선호 오디오 언어" Style="{StaticResource RowName}"/>
                                    <TextBlock Text="예: ko,kor,ja. 비우면 기본 동작입니다." Style="{StaticResource RowHint}" MaxWidth="280"/>
                                </StackPanel>
                                <TextBox x:Name="AudioLangBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="180" Height="28" LostFocus="Langs_LostFocus" KeyDown="Langs_KeyDown"/>
                            </Grid>
                        </StackPanel>

                        <!-- 4. 화면 · 소리 조절 (슬라이더 행은 코드에서 채움) -->
                        <StackPanel x:Name="PaneAdjust" Visibility="Collapsed">
                            <TextBlock Text="화면 · 소리 조절" Style="{StaticResource PaneTitle}"/>
                            <TextBlock Text="영상 화질" Style="{StaticResource RowName}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="VideoRows" Margin="0,0,0,18"/>
                            <TextBlock Text="이퀄라이저" Style="{StaticResource RowName}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="EqRows" Margin="0,0,0,18"/>
                            <Button Content="모두 초기화" HorizontalAlignment="Left" Click="ResetAdjust_Click"/>
                        </StackPanel>

                        <!-- 5. 북마크 · 정보 -->
                        <StackPanel x:Name="Pane4" Visibility="Collapsed">
                            <TextBlock Text="북마크 · 정보" Style="{StaticResource PaneTitle}"/>
                            <TextBlock Text="북마크" Style="{StaticResource RowName}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource BarDeepBrush}" CornerRadius="6" BorderBrush="#14FFFFFF" BorderThickness="1" MaxHeight="190" Margin="0,0,0,22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BookmarkList" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2" Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="16" Height="16" CornerRadius="4" Margin="8,0,8,0" Background="{Binding Brush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                                <Button Grid.Column="2" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Width="28" Height="24" Margin="2,0" Tag="{Binding}" Click="BmUp_Click" ToolTip="위로"/>
                                                <Button Grid.Column="3" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Width="28" Height="24" Margin="2,0" Tag="{Binding}" Click="BmDown_Click" ToolTip="아래로"/>
                                                <Button Grid.Column="4" Content="삭제" Height="24" Margin="2,0,6,0" Tag="{Binding}" Click="BmDelete_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="단축키" Style="{StaticResource RowName}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="ShortcutList" Margin="0,0,0,22"/>
                            <TextBlock Text="파일 연결" Style="{StaticResource RowName}" Margin="0,0,0,6"/>
                            <TextBlock Text="탐색기의 '연결 프로그램(다른 앱 선택)' 목록에 이 앱을 넣거나 뺍니다. Windows 는 기본 앱을 프로그램이 직접 바꾸지 못하게 해서, 등록한 뒤 '기본 앱 설정'에서 직접 골라야 합니다." Style="{StaticResource RowHint}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="AssocBtn" Height="28" MinWidth="130" Click="Assoc_Click"/>
                                <Button Content="기본 앱 설정 열기" Height="28" Margin="8,0,0,0" Click="OpenDefaultApps_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AssocStatus" Style="{StaticResource RowHint}" Margin="0,0,0,22"/>
                            <TextBlock Text="확장에서 앱으로 열기" Style="{StaticResource RowName}" Margin="0,0,0,6"/>
                            <TextBlock Text="확장의 '앱으로'에서 영상 주소와 선택한 재생 정보를 보낼 수 있습니다. 로그인 정보는 공유하지 않습니다." Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button x:Name="HandoffRegister" AutomationProperties.AutomationId="HandoffRegister" Focusable="True" Click="HandoffRegister_Click" HorizontalAlignment="Left" Height="30" MinWidth="130"/>
                            <TextBlock x:Name="HandoffRegistrationStatus" AutomationProperties.AutomationId="HandoffRegistrationStatus" Style="{StaticResource RowHint}" TextWrapping="Wrap" Margin="0,6,0,22"/>
                            <TextBlock Text="Hybrid PIP Player" Style="{StaticResource RowName}"/>
                            <TextBlock x:Name="InfoText" Style="{StaticResource RowHint}" TextWrapping="Wrap"/>
                            <Button x:Name="CopyDiagnosticsButton" Content="진단 복사" HorizontalAlignment="Left" Margin="0,10,0,0" Height="28" MinWidth="100" Click="CopyDiagnostics_Click"/>
                            <TextBlock x:Name="DiagnosticCopyStatus" Style="{StaticResource RowHint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
