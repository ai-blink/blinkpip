<Window x:Class="HybridPipPlayer.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="Height" Width="392"
        Focusable="False" Title="Hybrid PIP Player 알림">
    <!-- 영상 위에 잠깐 뜨는 알림. 활성화되지 않는 창이라(SourceInitialized) 재생 중인 창의 포커스를 가져가지 않는다.
         바깥 여백 16 은 그림자가 잘리지 않게 두는 공간이다. -->
    <Border Margin="16" CornerRadius="10" Background="{DynamicResource FieldBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ThumbBox" Grid.Column="0" Width="112" Height="63" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True"
                    Background="Black" VerticalAlignment="Top">
                <Image x:Name="Thumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,26,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="22" Height="22" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Click="Close_Click" ToolTip="닫기"/>
                </Grid>
                <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ActionBtn" HorizontalAlignment="Left" MinWidth="84" Click="Action_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
